<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title }) %>
<body class="<%= bodyClass %>" data-page="<%= pageId %>">
    <main class="auth-shell-main">
        <section class="auth-card auth-card-compact">
            <div class="auth-card-header">
                <span class="auth-badge">Auth Panel</span>
                <h1>Iniciar sesión</h1>
                <p>Ingresa con tu email y password.</p>
            </div>

            <form id="signInForm" class="stack-form">
                <div class="input-field">
                    <input id="email" name="email" type="email" required autocomplete="email">
                    <label for="email">Email</label>
                </div>

                <div class="input-field">
                    <input id="password" name="password" type="password" required autocomplete="current-password">
                    <label for="password">Password</label>
                </div>

                <button id="signInButton" type="submit" class="btn-large waves-effect waves-light accent-button full-width">
                    Ingresar
                </button>
            </form>

            <p class="helper-text-row">
                ¿No tienes cuenta?
                <a href="/signUp">Crear cuenta</a>
            </p>
        </section>
    </main>

    <%- include('../partials/scripts', { pageScript }) %>
</body>
</html>
