<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title }) %>
<body class="<%= bodyClass %>" data-page="<%= pageId %>">
    <main class="status-layout">
        <section class="status-card">
            <span class="eyebrow">404</span>
            <h1>Página no encontrada</h1>
            <p>La ruta solicitada no existe.</p>
            <div class="status-actions">
                <a href="/dashboard" class="btn-large accent-button waves-effect waves-light">Ir al dashboard</a>
                <a href="/signIn" class="btn-flat ghost-button">Volver a Sign In</a>
            </div>
        </section>
    </main>

    <%- include('../partials/scripts', { pageScript }) %>
</body>
</html>
